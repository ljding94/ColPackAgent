# Ignore everything first
*

# Then allow specific files and folders
!README.md

!doc
!doc/**

# Source code
!src
!src/**
src/__pycache__/

!agent
!agent/**

# plots
!plots/
!plots/*.py


# test
!tests/
!tests/**
tests/__pycache__/

# Git and project files
!.gitignore

# Python cache
__pycache__/

# macOS files
.DS_Store