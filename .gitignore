# Ignore everything first (root-level whitelist strategy)
/*

# Then allow specific files and folders
!/README.md

!/doc/
!/doc/**

# Explicitly include src tree needed for MCP
!/src/
!/src/colpack/
!/src/colpack/mcp/
!/src/colpack/mcp/**

# Keep Python cache ignored
/src/**/__pycache__/

!/agent/
!/agent/**

# plots
!/plots/
!/plots/*.py


# test
!/tests/
!/tests/**
/tests/**/__pycache__/

# Git and project files
!/.gitignore

# Python cache
__pycache__/

# macOS files
.DS_Store