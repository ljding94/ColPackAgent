# Ignore everything first (root-level whitelist strategy)
/*

!environment.yml
!run_colpack.sh

# Then allow specific files and folders
!/README.md

!/doc/
!/doc/**

# Explicitly include src tree needed for MCP
!/src/
!/src/colpack/
!/src/colpack/mcp/
!/src/colpack/mcp/**

# Keep Python cache ignored
/src/**/__pycache__/

# Build artifacts from python -m build
/src/dist/
/src/build/
/src/**/*.egg-info/

!/agent/
!/agent/**
!/eval/
!/eval/**
/eval/**/__pycache__/
/eval/data/
/eval/runs/
!/eval/data/
/eval/data/**
# Keep compact benchmark fixtures and run records available for reproduction.
!/eval/data/fixtures/
!/eval/data/fixtures/**
!/eval/runs/
!/eval/runs/**

!/demo/
!/demo/**
/demo/**/__pycache__/
/demo/data/
/demo/runs/
!/demo/data/
/demo/data/**
# Keep revised autoresearch analysis artifacts, but not the large raw trajectories.
!/demo/data/autoresearch_0629/
!/demo/data/autoresearch_0629/**/
!/demo/data/autoresearch_0629/**/*.csv
!/demo/data/autoresearch_0629/**/*.json
!/demo/data/autoresearch_0629/**/*.log
!/demo/data/autoresearch_0629/**/*.md
!/demo/data/autoresearch_0629/**/*.pdf
!/demo/data/autoresearch_0629/**/*.png
!/demo/data/autoresearch_0629/**/*.py
/demo/data/autoresearch_0629/**/*.gsd

# plots
!/plot/
!/plot/*.py
!/plot/figures/
!/plot/figures/**
!/plot/illustrative_data/
/plot/illustrative_data/**
# Keep plot inputs/outputs used by the manuscript figures, excluding trajectories.
!/plot/illustrative_data/**/
!/plot/illustrative_data/**/*.csv
!/plot/illustrative_data/**/*.json
!/plot/illustrative_data/**/*.log
!/plot/illustrative_data/**/*.md
!/plot/illustrative_data/**/*.pdf
!/plot/illustrative_data/**/*.png
/plot/illustrative_data/**/*.gsd


# test
!/tests/
!/tests/**
/tests/**/__pycache__/

# Git and project files
!/.gitignore

# GitHub Actions workflows
!/.github/
!/.github/**

# AGENTS.md lives in agent/ — Codex finds it by running from agent/ as CWD
!/agent/AGENTS.md

# Gemini CLI project settings live in agent/.gemini/
# Commit: settings.json (MCP config) and system.md (symlink -> ../agents/colpack_agent.md).
# Exclude: skills/ (machine-specific absolute symlinks; recreate with: ./run_colpack.sh setup)
!/agent/.gemini/
!/agent/.gemini/settings.json
!/agent/.gemini/system.md
/agent/.gemini/skills/

# Claude Code project settings live in .claude/
# Commit: settings.json (shared permission allowlist).
# Exclude: settings.local.json (per-user/per-machine permissions).
!/.claude/
/.claude/*
!/.claude/settings.json

# Python cache
__pycache__/

# macOS files
.DS_Store
