{
    "workflow": {
        "placeholder": "Nan",
        "initialize_defaults": {
            "initial_volume_fraction": 0.02,
            "max_overlap_reduction_iters": 10,
            "default_d": 1.0,
            "default_a": 0.1
        },
        "compression_defaults": {
            "max_steps_per_stage": 4000,
            "randomization_steps": 2000,
            "stages": 5,
            "npt_precompress_volume_fraction": 0.4,
            "npt_boxmc_steps": 2000,
            "npt_boxmc_volume_delta": 0.02,
            "npt_boxmc_trigger_period": 10
        },
        "sample_defaults": {
            "sample_steps": 20000,
            "npt_boxmc_trigger_period": 10,
            "npt_boxmc_volume_weight": 1.0,
            "npt_boxmc_volume_mode": "standard",
            "npt_boxmc_volume_delta": 0.01,
            "min_move_tune_updates": 10,
            "min_npt_boxmc_updates": 10,
            "move_tune_period": 100,
            "move_tune_target": 0.2,
            "box_tune_target": 0.3,
            "tune_warmup_steps": 2000
        },
        "parallel_defaults": {
            "cpu_reserve": 2,
            "max_workers": null
        },
        "particle_required_fields": [
            "relative_volume_fraction"
        ],
        "relative_volume_fraction_first_particle": 1,
        "relative_volume_fraction_other_particles": 0.5,
        "common_system_fields": {
            "sample_steps": 20000
        },
        "status_fieldnames": [
            "run_number",
            "dimension",
            "total_particle_number",
            "ensemble",
            "initialize",
            "compress",
            "sample",
            "analyze",
            "status",
            "execution_state",
            "started_at",
            "finished_at",
            "output_dir",
            "error"
        ],
        "ensemble_requirements": {
            "NVT": {
                "system_fields": {
                    "volume_fraction": 0.3
                }
            },
            "NPT": {
                "system_fields": {
                    "P": 1.0
                }
            }
        }
    },
    "analysis": {
        "available_analysis_params": {
            "order": {
                "Hexatic":                  {"params": {"k": 6, "weighted": false},                                         "notes": "2D bond-orientational order; set k to match lattice symmetry (k=6 hexagonal, k=4 square, k=3 triangular)."},
                "Nematic":                  {"params": {},                                                                   "notes": "Nematic order parameter for rod-like particles from orientation vectors."},
                "Steinhardt":               {"params": {"l": 6, "average": false, "wl": false, "weighted": false},           "notes": "Steinhardt bond-orientational order; l=6 FCC/HCP, l=4 BCC/cubic, l=3 tetrahedral. 'l' is required."},
                "ContinuousCoordination":   {"params": {"powers": null, "compute_log": true, "compute_exp": true},           "notes": "Continuous coordination number from Voronoi tessellation."},
                "Cubatic":                  {"params": {"t_initial": 5.0, "t_final": 0.001, "scale": 0.9, "n_replicates": 1},"notes": "Cubatic order for cubic-symmetry particles; uses simulated annealing. 't_initial', 't_final', 'scale' are required."},
                "SolidLiquid":              {"params": {"l": 6, "q_threshold": 0.7, "solid_threshold": 6, "normalize_q": true}, "notes": "Identifies solid-like vs liquid-like particles. 'l', 'q_threshold', 'solid_threshold' are required."},
                "RotationalAutocorrelation":{"params": {"l": 2},                                                             "notes": "Rotational autocorrelation from quaternion time series. 'l' is required."}
            },
            "density": {
                "RDF":                {"params": {"bins": 100, "r_max": 5.0, "r_min": 0.1},   "notes": "Radial distribution function g(r). Already computed for multi-component systems."},
                "LocalDensity":       {"params": {"r_max": 3.0, "diameter": 1.0},              "notes": "Local number density and packing fraction within a sphere of radius r_max."},
                "GaussianDensity":    {"params": {"width": 50, "r_max": 5.0, "sigma": 0.1},    "notes": "Gaussian-smeared 3D density field on a regular grid."},
                "CorrelationFunction":{"params": {"bins": 100, "r_max": 5.0},                  "notes": "Spatial correlation function of per-particle scalar quantities."}
            },
            "system": {
                "VolumeFraction":     {"params": {},                                           "notes": "System-level packing fraction phi = total_particle_volume / box_volume computed per frame. Requires 'total_particle_volume' in simulation_config. Box volume is Lx*Ly in 2D and Lx*Ly*Lz in 3D."}
            }
        },
        "system_params": [
            {"name": "volume_fraction", "type": "VolumeFraction", "params": {}}
        ],
        "rdf_defaults": {
            "max_cap": 4.0,
            "bins": 100,
            "r_min": 0.1
        },
        "n_neighbors_2d": 6,
        "n_neighbors_3d": 12,
        "shape_order_params": {
            "disk":      [{"name": "hexatic_6",     "type": "Hexatic",    "params": {"k": 6}}],
            "triangle":  [{"name": "hexatic_3",     "type": "Hexatic",    "params": {"k": 3}}],
            "square":    [{"name": "hexatic_4",     "type": "Hexatic",    "params": {"k": 4}}],
            "rectangle": [{"name": "nematic",       "type": "Nematic",    "params": {}},
                          {"name": "hexatic_2",     "type": "Hexatic",    "params": {"k": 2}}],
            "ellipse":   [{"name": "nematic",       "type": "Nematic",    "params": {}}],
            "sphere":    [{"name": "steinhardt_q6", "type": "Steinhardt", "params": {"l": 6}},
                          {"name": "steinhardt_q4", "type": "Steinhardt", "params": {"l": 4}},
                          {"name": "solid_liquid_q6", "type": "SolidLiquid", "params": {"l": 6, "q_threshold": 0.7, "solid_threshold": 6}}],
            "ellipsoid": [{"name": "nematic",       "type": "Nematic",    "params": {}}],
            "capsule":   [{"name": "nematic",       "type": "Nematic",    "params": {}}],
            "tetrahedron":[{"name": "steinhardt_q3","type": "Steinhardt", "params": {"l": 3}},
                           {"name": "solid_liquid_q6", "type": "SolidLiquid", "params": {"l": 6, "q_threshold": 0.7, "solid_threshold": 6}}],
            "cube":      [{"name": "steinhardt_q4", "type": "Steinhardt", "params": {"l": 4}},
                          {"name": "cubatic",       "type": "Cubatic",    "params": {"t_initial": 5.0, "t_final": 0.001, "scale": 0.9}}]
        }
    },
    "dimensions": {
        "2": {
            "allowed_shapes": [
                "disk",
                "ellipse",
                "triangle",
                "square",
                "rectangle",
                "capsule"
            ],
            "aliases": {
                "circle": "disk",
                "sphere": "disk",
                "rod": "capsule"
            },
            "shape_parameters": {
                "disk": {
                    "defaults": {
                        "diameter": 1.0
                    }
                },
                "ellipse": {
                    "defaults": {
                        "a": 1.0,
                        "b": 0.5,
                        "c": 0.25
                    }
                },
                "triangle": {
                    "defaults": {
                        "side": 1.0
                    }
                },
                "square": {
                    "defaults": {
                        "side": 1.0
                    }
                },
                "rectangle": {
                    "defaults": {
                        "length": 2.0,
                        "width": 1.0
                    }
                },
                "capsule": {
                    "defaults": {
                        "length": 2.0,
                        "diameter": 1.0
                    }
                }
            }
        },
        "3": {
            "allowed_shapes": [
                "sphere",
                "ellipsoid",
                "cube",
                "octahedron",
                "tetrahedron",
                "capsule"
            ],
            "aliases": {
                "ball": "sphere",
                "rod": "capsule",
                "tetra": "tetrahedron"
            },
            "shape_parameters": {
                "sphere": {
                    "defaults": {
                        "diameter": 1.0
                    }
                },
                "ellipsoid": {
                    "defaults": {
                        "a": 1.0,
                        "b": 0.5,
                        "c": 0.5
                    }
                },
                "capsule": {
                    "defaults": {
                        "length": 2.0,
                        "diameter": 1.0
                    }
                },
                "tetrahedron": {
                    "defaults": {
                        "side": 1.0
                    }
                },
                "cube": {
                    "defaults": {
                        "side": 1.0
                    }
                },
                "octahedron": {
                    "defaults": {
                        "side": 1.0
                    }
                }
            }
        }
    }
}
